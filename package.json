{
  "name": "cnerd-blog-engine",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=private/runtime.env src/server.mjs",
    "dev": "node --env-file-if-exists=private/runtime.env --watch src/server.mjs",
    "build:editor": "vite build",
    "build": "npm run build:editor && node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "setup": "node scripts/setup.mjs",
    "demo": "node scripts/demo.mjs",
    "qa:local": "node scripts/local-qa.mjs",
    "backup": "node scripts/backup.mjs",
    "client": "node scripts/blog-client.mjs"
  },
  "dependencies": {
    "@floating-ui/react": "0.27.20",
    "@radix-ui/react-dropdown-menu": "2.1.25",
    "@radix-ui/react-popover": "1.2.0",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-code-block-lowlight": "3.31.4",
    "@tiptap/extension-find-and-replace": "3.31.4",
    "@tiptap/extension-highlight": "3.31.4",
    "@tiptap/extension-horizontal-rule": "3.31.4",
    "@tiptap/extension-image": "3.31.4",
    "@tiptap/extension-list": "3.31.4",
    "@tiptap/extension-subscript": "3.31.4",
    "@tiptap/extension-superscript": "3.31.4",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/extension-text-align": "3.31.4",
    "@tiptap/extension-typography": "3.31.4",
    "@tiptap/extensions": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "clsx": "2.1.1",
    "lodash.throttle": "4.1.1",
    "lowlight": "3.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hotkeys-hook": "5.3.3"
  },
  "devDependencies": {
    "@base-ui/react": "1.8.0",
    "@playwright/test": "1.58.2",
    "@types/lodash.throttle": "4.1.9",
    "class-variance-authority": "0.7.1",
    "sass": "1.105.1",
    "sass-embedded": "1.105.1",
    "vite": "8.3.2"
  },
  "description": "Brand-configurable server-rendered blog engine with scoped AI draft integration",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/CNERDAI/blog-engine.git"
  }
}
